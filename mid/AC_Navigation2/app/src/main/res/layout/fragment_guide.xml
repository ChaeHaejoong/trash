<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="3dp"
    android:background="#F7F9FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/primary_blue"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:textColor="@android:color/white"
        android:textSize="19sp"
        android:textStyle="bold"
        android:text="@string/guide_toolbar_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/facility_usage_guide"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/guide_body"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/main_phone"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/phone_number"
                android:textColor="@color/primary_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_call_school"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                 android:drawablePadding="10dp"
                android:backgroundTint="@color/button_light"
                android:text="@string/call_school"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_open_website"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:drawablePadding="10dp"
                android:backgroundTint="@color/button_light"
                android:text="@string/open_school_website"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
